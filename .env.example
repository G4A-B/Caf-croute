# Copier ce fichier en .env pour le développement local. Ne jamais commiter .env.

# Côté navigateur (public, préfixe VITE_)
VITE_VAPID_PUBLIC_KEY=

# Côté serveur seulement (fonctions api/), JAMAIS de préfixe VITE_
VAPID_PRIVATE_KEY=
NOTIFY_SECRET=
# Upstash : créées par l'intégration Vercel (KV_REST_API_*) ou à la main (UPSTASH_REDIS_REST_*)
KV_REST_API_URL=
KV_REST_API_TOKEN=
